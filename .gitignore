node_modules/
out/
dist/
release/
test-results/
playwright-report/
*.log
.DS_Store
coverage/
docker/data/
*.local

# apps/CarDash (Xcode / SwiftPM)
apps/**/DerivedData/
apps/**/.build/
apps/**/.swiftpm/
apps/**/xcuserdata/
apps/**/*.xcuserdatad
apps/**/Secrets.xcconfig
# Xcode writes this inside the .xcodeproj the first time the project is opened. It holds
# per-machine workspace state, not project structure, and showing up as untracked in every
# `git status` makes real changes harder to see.
apps/**/*.xcodeproj/project.xcworkspace/
apps/**/*.xcodeproj/xcshareddata/swiftpm/
