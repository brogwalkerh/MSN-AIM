<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleDisplayName</key>
	<string>CarDash</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- An empty UILaunchScreen dict opts into the modern launch path. Without it the
	     app runs letterboxed in a compatibility mode, which on a landscape-only car
	     dashboard looks like a layout bug. -->
	<key>UILaunchScreen</key>
	<dict/>

	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>

	<!-- The phone lives in a landscape mount. Portrait on iPhone is deliberately not
	     offered: the tiling engine degrades to a single focused pane there (see
	     LayoutAdaptation), and offering a squeezed grid would be worse than not
	     offering it. iPad is unconstrained. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<!-- Exactly two, and no more. `audio` keeps locally-owned playback alive when the
	     screen locks; `location` keeps navigation running. Declaring modes the app does
	     not actually use invites watchdog terminations. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>location</string>
	</array>

	<key>NSLocationWhenInUseUsageDescription</key>
	<string>CarDash uses your location to show your position on the map, give directions, and drive the speed and heading gauges.</string>
	<key>NSAppleMusicUsageDescription</key>
	<string>CarDash needs access to your music library to play your songs and show what is currently playing.</string>
	<key>NSMotionUsageDescription</key>
	<string>CarDash uses motion data to show acceleration and cornering on the dashboard gauges.</string>

	<!-- Required for the Spotify SDK. Without this entry canOpenURL("spotify:")
	     returns false and authorization silently fails with no error worth reading. -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>spotify</string>
	</array>

	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(CARDASH_URL_SCHEME)</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
