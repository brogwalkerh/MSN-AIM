<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleDisplayName</key>
	<string>CarDash</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- An empty UILaunchScreen dict opts into the modern launch path. Without it the
	     app runs letterboxed in a compatibility mode, which on a landscape-only car
	     dashboard looks like a layout bug. -->
	<key>UILaunchScreen</key>
	<dict/>

	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>

	<!-- The phone lives in a landscape mount. Portrait on iPhone is deliberately not
	     offered: the tiling engine degrades to a single focused pane there (see
	     LayoutAdaptation), and offering a squeezed grid would be worse than not
	     offering it. iPad is unconstrained. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<!-- Exactly two, and no more. `audio` keeps locally-owned playback alive when the
	     screen locks; `location` keeps navigation running. Declaring modes the app does
	     not actually use invites watchdog terminations. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>location</string>
	</array>

	<!-- Without this, Activity.request throws at runtime and nothing else says why. It
	     belongs in the *app's* plist, not the extension's. -->
	<key>NSSupportsLiveActivities</key>
	<true/>
	<!-- Lets the app push a new manoeuvre while backgrounded, which is the entire point:
	     the lock screen has to keep up while the app is not on screen. -->
	<key>NSSupportsLiveActivitiesFrequentUpdates</key>
	<true/>

	<key>NSLocationWhenInUseUsageDescription</key>
	<string>CarDash uses your location to show your position on the map, give directions, and drive the speed and heading gauges.</string>
	<key>NSAppleMusicUsageDescription</key>
	<string>CarDash needs access to your music library to play your songs and show what is currently playing.</string>
	<key>NSMotionUsageDescription</key>
	<string>CarDash uses motion data to show acceleration and cornering on the dashboard gauges.</string>

	<!-- Without this entry canOpenURL("spotify:") returns false, so the tile cannot tell
	     "Spotify is not installed" from "Spotify is installed but not running" — and the
	     offer to open Spotify, which is the fix for having no active device, silently
	     does nothing. -->
	<!-- `tel` and `sms` are here for canOpenURL, which is how the Phone tile tells a
	     device that can place calls from an iPad that cannot. Without the declaration
	     canOpenURL returns false everywhere and the dial button would be permanently
	     disabled on a phone that dials perfectly well. -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>spotify</string>
		<string>tel</string>
		<string>sms</string>
	</array>

	<!-- Supplied by Secrets.xcconfig, which is untracked. Empty in a fresh clone, and
	     that is a supported state: the Spotify tile explains what to do and everything
	     else works. PKCE means there is no client secret to go with it — a secret
	     shipped inside an app is not a secret. -->
	<key>SpotifyClientID</key>
	<string>$(SPOTIFY_CLIENT_ID)</string>

	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(CARDASH_URL_SCHEME)</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
