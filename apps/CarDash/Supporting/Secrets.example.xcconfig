// Copy this file to Secrets.xcconfig (same directory) and fill in the values.
//
//     cp Supporting/Secrets.example.xcconfig Supporting/Secrets.xcconfig
//
// Secrets.xcconfig is gitignored. Base.xcconfig includes it optionally with
// `#include?`, so the project builds fine when it does not exist — which is exactly
// what CI relies on.

// Your 10-character Apple Developer Team ID.
// Xcode → Settings → Accounts → your team → the ID in parentheses, or
// developer.apple.com → Membership.
// Only needed to install on a physical device; simulator builds do not use it.
DEVELOPMENT_TEAM =

// From developer.spotify.com/dashboard → your app → Settings → Client ID.
// The matching app must list redirect URI `cardash://spotify-callback` and the bundle
// identifier from CARDASH_BUNDLE_ID in Base.xcconfig.
// There is no client secret: the app uses the PKCE flow, which does not need one and
// must not ship one.
SPOTIFY_CLIENT_ID =
